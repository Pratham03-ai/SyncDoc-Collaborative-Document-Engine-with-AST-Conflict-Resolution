{
  "name": "syncdoc",
  "version": "1.0.0",
  "description": "Collaborative Document Engine with AST Conflict Resolution",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "vite --config client/vite.config.js client",
    "build": "vite build client --config client/vite.config.js",
    "test": "vitest run",
    "test:stress": "node tests/stress-test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dompurify": "^3.1.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsdom": "^24.1.1",
    "lucide-react": "^0.439.0",
    "marked": "^14.1.0",
    "mongodb-memory-server": "^9.4.0",
    "mongoose": "^8.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^10.0.0",
    "ws": "^8.18.0",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.18"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "vite": "^5.4.3",
    "vitest": "^2.0.5"
  }
}
